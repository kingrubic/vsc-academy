<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.vsc.academy.convex</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/vsc_agent/projects/VSC-ACADEMY/scripts/vsc-academy-convex-ensure.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/vsc_agent/projects/VSC-ACADEMY</string>
