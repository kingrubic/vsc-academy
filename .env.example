# Environment (do not put secrets here)

# Web
# HOST=127.0.0.1
# PORT=4173
# NODE_ENV=production
# SESSION_SECRET=

# Required exact https origin for activation / password-reset email links
# PUBLIC_SITE_URL=https://vscacademy.edu.vn
# Extra approved hosts only (comma-separated); do not add unverified aliases
# PUBLIC_SITE_URL_HOSTS=

# Convex self-hosted
# CONVEX_URL=http://127.0.0.1:3280
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3280

# Seed only (never commit real values)
# VSC_OWNER_TEMP_PASSWORD=
# VSC_ADMIN_TEMP_PASSWORD=

# SMTP for activation / password-reset email (Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=vscacademy8@gmail.com
