# Environment (do not put secrets here)

# Web
# HOST=127.0.0.1
# PORT=4173
# NODE_ENV=production
# SESSION_SECRET=

# Public origin for certificate QR / verify links
# PUBLIC_SITE_URL=https://vscacademy.vn

# Convex self-hosted
# CONVEX_URL=http://127.0.0.1:3280
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3280

# Seed only (never commit real values)
# VSC_OWNER_TEMP_PASSWORD=
# VSC_ADMIN_TEMP_PASSWORD=
